#!/bin/sh
[ -x /etc/init.d/samwaf ] && [ -x /usr/bin/samwaf ] || exit 0
if ! uci -q get samwaf.config >/dev/null; then
	uci set samwaf.config=samwaf || exit 1
fi
if ! uci -q get samwaf.config.port >/dev/null; then
	uci set samwaf.config.port=26666 || exit 1
fi
uci commit samwaf || exit 1
# A retained configuration may intentionally have disabled the service.
[ -f /etc/uci-defaults/.upgrading ] && exit 0
/etc/init.d/samwaf enable && /etc/init.d/samwaf start
