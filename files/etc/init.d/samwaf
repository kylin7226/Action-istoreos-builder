#!/bin/sh /etc/rc.common
# SamWaf —— 开源轻量级 Web 应用防火墙（https://github.com/samwafgo/SamWaf）
# 官方 release 的静态 aarch64 Go 二进制（musl 兼容），由 build.yml 下载后装到 /usr/bin/samwaf。
# 直接前台运行即启动服务（其自带的 install/start/stop 是给 systemd 用的，OpenWrt 无 systemd，
# 故这里用 procd 托管前台进程）。运行时会在工作目录下生成 conf/ data/ logs/ ssl/，
# 因此工作目录必须落在可写 overlay 上（默认 /opt/samwaf）。
# 管理页默认端口 26666；账号 admin，初始随机密码见 <工作目录>/data/initial_password.txt。
USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/samwaf
WORKDIR=/opt/samwaf
CONFDIR="$WORKDIR/conf"
CFG="$CONFDIR/config.yml"

# SamWaf 只在进程启动时读取 conf/config.yml，端口在其中的 local_port 字段。
# 这里把 UCI（samwaf.config.port，由 LuCI 管理页修改）同步进去，实现「LuCI 改端口 → 重启生效」。
# config.yml 由 SamWaf 首次运行时自动生成；若尚不存在则写一行最小配置（其余字段用内置默认补全）。
sync_port() {
	port=$(uci -q get samwaf.config.port 2>/dev/null)
	[ -n "$port" ] || port=26666
	mkdir -p "$CONFDIR"
	if [ -f "$CFG" ] && grep -Eq '^[[:space:]]*local_port:' "$CFG"; then
		sed -i "s/^[[:space:]]*local_port:.*/local_port: ${port}/" "$CFG"
	else
		printf 'local_port: %s\n' "$port" >> "$CFG"
	fi
}

start_service() {
	[ -x "$PROG" ] || { logger -t samwaf "$PROG 不存在或不可执行，跳过"; return 1; }
	mkdir -p "$WORKDIR"
	sync_port
	procd_open_instance samwaf
	procd_set_param command "$PROG"
	procd_set_param cwd "$WORKDIR"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core="unlimited"
	procd_close_instance
}
