#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/samwaf
WORKDIR=/opt/samwaf

start_service() {
	[ -x "$PROG" ] || return 1
	local port
	port=$(uci -q get samwaf.config.port) || return 1
	case "$port" in ''|*[!0-9]*) return 1;; esac
	[ "${#port}" -le 5 ] || return 1
	port=$(printf '%s' "$port" | sed 's/^0*//')
	[ -n "$port" ] && [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || return 1
	umask 077
	mkdir -p "$WORKDIR/conf" || return 1
	local cfg="$WORKDIR/conf/config.yml"
	if [ -f "$cfg" ]; then
		sed '/^local_port[[:space:]]*:/d' "$cfg" > "$cfg.new" || return 1
	else
		: > "$cfg.new" || return 1
	fi
	printf 'local_port: %s\n' "$port" >> "$cfg.new" || return 1
	mv "$cfg.new" "$cfg" || return 1
	procd_open_instance samwaf
	# procd has no cwd parameter; exec keeps its supervised PID as the actual server.
	procd_set_param command /bin/sh -c 'cd /opt/samwaf && exec /usr/bin/samwaf'
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core=0
	procd_close_instance
}
