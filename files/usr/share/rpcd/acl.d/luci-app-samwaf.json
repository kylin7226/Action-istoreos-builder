{
	"luci-app-samwaf": {
		"description": "Manage SamWaf",
		"read": {
			"ubus": { "file": [ "exec" ] },
			"file": {
				"/usr/libexec/samwafctl status": [ "exec" ],
				"/usr/libexec/samwafctl upgrade_status": [ "exec" ]
			}
		},
		"write": {
			"ubus": { "file": [ "exec" ] },
			"file": {
				"/usr/libexec/samwafctl start": [ "exec" ],
				"/usr/libexec/samwafctl stop": [ "exec" ],
				"/usr/libexec/samwafctl restart": [ "exec" ],
				"/usr/libexec/samwafctl enable": [ "exec" ],
				"/usr/libexec/samwafctl disable": [ "exec" ],
				"/usr/libexec/samwafctl set_port *": [ "exec" ],
				"/usr/libexec/samwafctl upgrade *": [ "exec" ]
			}
		}
	}
}
