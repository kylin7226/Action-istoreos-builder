#!/bin/sh
. /usr/share/libubox/jshn.sh
umask 077

SELF=/usr/libexec/samwafctl
PROG=/usr/bin/samwaf
WORKDIR=/opt/samwaf
INIT=/etc/init.d/samwaf
VERFILE=/usr/share/samwaf/VERSION
UPDIR="$WORKDIR/.upgrade"
UPLOG="$UPDIR/upgrade.log"
LOCK=/var/lock/samwafctl.lock
REPO_BASE=https://github.com/samwafgo/SamWaf/releases/download

fail() {
	json_init
	json_add_boolean ok 0
	json_add_string error "$1"
	json_dump
	exit 1
}

success() {
	json_init
	json_add_boolean ok 1
	json_dump
}

normalize_port() {
	case "$1" in ''|*[!0-9]*) return 1;; esac
	[ "${#1}" -le 5 ] || return 1
	PORT=$(printf '%s' "$1" | sed 's/^0*//')
	[ -n "$PORT" ] && [ "$PORT" -ge 1 ] && [ "$PORT" -le 65535 ]
}

normalize_version() {
	[ "${#1}" -le 64 ] || return 1
	printf '%s\n' "$1" | grep -Eq '^v?[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.]+)?$' || return 1
	VERSION="v${1#v}"
}

running() {
	[ "$(ubus call service list '{"name":"samwaf"}' 2>/dev/null | jsonfilter -e '@.samwaf.instances.samwaf.running')" = true ]
}

upgrading() {
	[ "$(ubus call service list '{"name":"samwaf-upgrade"}' 2>/dev/null | jsonfilter -e '@["samwaf-upgrade"].instances.worker.running')" = true ]
}

lock_control() {
	exec 9>"$LOCK" || fail '无法打开操作锁'
	flock -n 9 || fail '另一项 SamWaf 操作正在进行'
	upgrading && fail '升级正在进行，请稍后再操作'
	return 0
}

status_json() {
	local state pid enabled=0 active=0
	state=$(ubus call service list '{"name":"samwaf"}') || fail '无法查询 procd 状态'
	pid=$(printf '%s' "$state" | jsonfilter -e '@.samwaf.instances.samwaf.pid')
	[ "$(printf '%s' "$state" | jsonfilter -e '@.samwaf.instances.samwaf.running')" = true ] && active=1
	"$INIT" enabled >/dev/null 2>&1 && enabled=1
	normalize_port "$(uci -q get samwaf.config.port)" || fail 'UCI 管理端口无效'
	json_init
	json_add_boolean ok 1
	json_add_boolean running "$active"
	json_add_int pid "${pid:-0}"
	json_add_boolean enabled "$enabled"
	json_add_int port "$PORT"
	json_add_string version "$(cat "$VERFILE" 2>/dev/null || printf unknown)"
	json_dump
}

healthy() {
	local attempt=0 stable=0 pid previous='' limit="${1:-5}"
	normalize_port "$(uci -q get samwaf.config.port)" || return 1
	while [ "$attempt" -lt "$limit" ]; do
		pid=$(ubus call service list '{"name":"samwaf"}' 2>/dev/null | jsonfilter -e '@.samwaf.instances.samwaf.pid')
		if [ -n "$pid" ] && running && curl -fsS --connect-timeout 1 --max-time 1 -o /dev/null "http://127.0.0.1:$PORT/"; then
			if [ "$pid" = "$previous" ]; then stable=$((stable + 1)); else stable=1; fi
			[ "$stable" -ge 3 ] && return 0
		else
			stable=0
		fi
		previous="$pid"
		attempt=$((attempt + 1))
		sleep 1
	done
	return 1
}

hex_at() {
	dd if="$1" bs=1 skip="$2" count="$3" 2>/dev/null | hexdump -v -e '1/1 "%02x"'
}

little_uint() {
	local byte value=0 factor=1
	for byte in $(dd if="$1" bs=1 skip="$2" count="$3" 2>/dev/null | hexdump -v -e '1/1 "%u "'); do
		value=$((value + byte * factor))
		factor=$((factor * 256))
	done
	printf '%s' "$value"
}

verify_elf() {
	local size offset count width type index=0
	[ "$(hex_at "$1" 0 7)" = 7f454c46020101 ] || return 1
	[ "$(hex_at "$1" 18 2)" = b700 ] || return 1
	case "$(hex_at "$1" 16 2)" in 0200|0300) ;; *) return 1;; esac
	size=$(wc -c < "$1")
	offset=$(little_uint "$1" 32 8)
	width=$(little_uint "$1" 54 2)
	count=$(little_uint "$1" 56 2)
	[ "$offset" -ge 64 ] && [ "$offset" -le "$size" ] && [ "$width" -eq 56 ] || return 1
	[ "$count" -gt 0 ] && [ "$count" -le 256 ] && [ "$((offset + count * width))" -le "$size" ] || return 1
	while [ "$index" -lt "$count" ]; do
		type=$(little_uint "$1" "$((offset + index * width))" 4)
		[ "$type" -ne 2 ] && [ "$type" -ne 3 ] || return 1
		index=$((index + 1))
	done
}

finish_upgrade() {
	printf '%s\n' "$1" > "$UPDIR/result.new" && mv "$UPDIR/result.new" "$UPDIR/result"
}

upgrade_worker() {
	normalize_version "$1" || fail '版本号格式无效'
	exec 9>"$LOCK" || exit 1
	flock 9 || exit 1
	mkdir -p "$UPDIR" || exit 1
	exec >>"$UPLOG" 2>&1
	was_running=0; replaced=0; stopped=0; saved_data=0; saved_version=0; result=1
	work=$(mktemp -d "$UPDIR/work.XXXXXX") || { finish_upgrade fail; return 1; }
	# Keep both the executable and pre-migration data until the new process passes health checks.
	trap 'upgrade_cleanup' EXIT
	trap 'exit 1' HUP INT TERM
	upgrade_cleanup() {
		if [ "$result" -ne 0 ] && [ "$stopped" -eq 1 ]; then
			if ! "$INIT" stop >/dev/null 2>&1 || running; then
				printf '无法停止新进程，保留备份供手工恢复：%s\n' "$work"
				finish_upgrade fail
				return
			fi
			local restored=1
			if [ "$replaced" -eq 1 ]; then
				cp "$work/samwaf.old" "$PROG.new" && chmod 755 "$PROG.new" && mv "$PROG.new" "$PROG" || restored=0
				if [ "$saved_data" -eq 1 ]; then
					rm -rf "$WORKDIR/conf" "$WORKDIR/data" "$WORKDIR/ssl"
					tar -xzf "$work/data.tar.gz" -C "$WORKDIR" || restored=0
				fi
				if [ "$saved_version" -eq 1 ]; then cp "$work/version" "$VERFILE" || restored=0; else rm -f "$VERFILE"; fi
			fi
			if [ "$was_running" -eq 1 ] && [ "$restored" -eq 1 ]; then
				"$INIT" start >/dev/null 2>&1 && healthy 15 || restored=0
			fi
			if [ "$restored" -eq 1 ]; then
				printf '%s\n' '升级失败，已恢复原版本及原运行状态'
			else
				printf '回滚或恢复服务失败，请保留备份并手工恢复：%s\n' "$work"
				finish_upgrade fail
				return
			fi
		fi
		if [ "$result" -eq 0 ]; then finish_upgrade ok; else finish_upgrade fail; fi
		rm -f "$PROG.new"
		rm -rf "$work"
	}
	local archive="$work/samwaf.tar.gz" num="${VERSION#v}" base="$REPO_BASE/$VERSION" want got member count
	printf '下载 %s\n' "$VERSION"
	curl -fL --retry 3 --connect-timeout 20 --max-time 600 --max-filesize 268435456 -o "$archive" "$base/SamWaf_Linux_arm64.${VERSION}.tar.gz" || return 1
	curl -fL --retry 3 --connect-timeout 20 --max-time 120 -o "$work/checksums" "$base/SamWaf_${num}_checksums.txt" || return 1
	want=$(awk '/Linux_arm64/ {print $1}' "$work/checksums")
	printf '%s\n' "$want" | grep -Eq '^[0-9a-fA-F]{64}$' || return 1
	got=$(sha256sum "$archive"); got=${got%% *}
	[ "$want" = "$got" ] || { printf '%s\n' 'SHA256 校验失败'; return 1; }
	tar -tzf "$archive" > "$work/members" || return 1
	member=$(grep -E '(^|/)SamWafLinux[^/]*$' "$work/members")
	count=$(printf '%s\n' "$member" | wc -l)
	[ -n "$member" ] && [ "$count" -eq 1 ] || return 1
	tar -xOzf "$archive" -- "$member" > "$PROG.new" || return 1
	verify_elf "$PROG.new" || { printf '%s\n' '必须为静态链接的 ARM64 ELF'; return 1; }
	chmod 755 "$PROG.new" || return 1
	cp "$PROG" "$work/samwaf.old" || return 1
	if [ -f "$VERFILE" ]; then cp "$VERFILE" "$work/version" || return 1; saved_version=1; fi
	running && was_running=1
	stopped=1
	"$INIT" stop || return 1
	running && return 1
	local dirs=''
	for member in conf data ssl; do
		[ ! -e "$WORKDIR/$member" ] || dirs="$dirs $member"
	done
	if [ -n "$dirs" ]; then
		tar -czf "$work/data.tar.gz" -C "$WORKDIR" $dirs || return 1
	else
		mkdir "$work/empty" || return 1
		tar -czf "$work/data.tar.gz" -C "$work/empty" . || return 1
	fi
	saved_data=1
	mv "$PROG.new" "$PROG" || return 1
	replaced=1
	"$INIT" start && healthy 15 || return 1
	mkdir -p "${VERFILE%/*}" || return 1
	printf '%s\n' "$VERSION" > "$VERFILE.new" && mv "$VERFILE.new" "$VERFILE" || return 1
	if [ "$was_running" -eq 0 ]; then "$INIT" stop || return 1; fi
	result=0
	printf '升级完成：%s\n' "$VERSION"
}

cmd=${1:-help}
[ "$#" -eq 0 ] || shift
case "$cmd" in
status)
	[ "$#" -eq 0 ] || fail '参数数量错误'
	status_json
	;;
start|stop|restart|enable|disable)
	[ "$#" -eq 0 ] || fail '参数数量错误'
	lock_control
	"$INIT" "$cmd" >&2 || fail '服务操作失败'
	case "$cmd" in
		start|restart) healthy || fail '进程或 HTTP 健康检查失败';;
		stop) running && fail '服务未停止';;
	esac
	status_json
	;;
set_port)
	[ "$#" -eq 1 ] && normalize_port "$1" || fail '端口必须是 1–65535 的整数'
	new_port="$PORT"
	lock_control
	old_port=$(uci -q get samwaf.config.port) || fail '读取原端口失败'
	was_running=0
	running && was_running=1
	uci -q set "samwaf.config.port=$new_port" && uci -q commit samwaf || {
		uci -q revert samwaf
		fail '保存 UCI 配置失败'
	}
	if [ "$was_running" -eq 1 ]; then
		if ! "$INIT" restart >&2 || ! healthy; then
			uci -q set "samwaf.config.port=$old_port" && uci -q commit samwaf && "$INIT" restart >&2 && healthy \
				|| fail '新端口不可用且恢复失败，请检查服务日志'
			fail '新端口不可用，已恢复原端口'
		fi
	fi
	json_init
	json_add_boolean ok 1
	json_add_int port "$new_port"
	json_add_boolean restarted "$was_running"
	json_dump
	;;
upgrade)
	[ "$#" -eq 1 ] && normalize_version "$1" || fail '版本号格式无效'
	lock_control
	mkdir -p "$UPDIR" || fail '无法创建升级目录'
	: > "$UPLOG" || fail '无法写入升级日志'
	printf 'pending\n' > "$UPDIR/result" || fail '无法记录升级状态'
	ubus call service delete '{"name":"samwaf-upgrade"}' >/dev/null 2>&1
	json_init
	json_add_string name samwaf-upgrade
	json_add_object instances
	json_add_object worker
	json_add_array command
	json_add_string '' "$SELF"
	json_add_string '' _upgrade
	json_add_string '' "$VERSION"
	json_close_array
	json_add_boolean stdout 1
	json_add_boolean stderr 1
	json_close_object
	json_close_object
	ubus call service set "$(json_dump)" >/dev/null || { finish_upgrade fail; fail '无法启动后台升级服务'; }
	success
	;;
_upgrade)
	[ "$#" -eq 1 ] || fail '参数数量错误'
	upgrade_worker "$1"
	exit $?
	;;
upgrade_status)
	[ "$#" -eq 0 ] || fail '参数数量错误'
	active=0
	upgrading && active=1
	result=$(cat "$UPDIR/result" 2>/dev/null)
	log=$(tail -c 16384 "$UPLOG" 2>/dev/null)
	json_init
	json_add_boolean ok 1
	json_add_boolean running "$active"
	if [ "$active" -eq 1 ] || [ -z "$result" ]; then
		json_add_null done
	else
		[ "$result" = ok ] && done=1 || done=0
		json_add_boolean done "$done"
		[ "$result" != pending ] || log="$log
后台任务已退出，升级未完成。"
	fi
	json_add_string log "$log"
	json_dump
	;;
*)
	fail '未知命令'
	;;
esac
